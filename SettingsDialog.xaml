<Window x:Class="JuChuang.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JNest 设置" Icon="Assets/app.ico" Width="540" Height="392"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F7F8FA" ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI, Segoe UI">
    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <Grid Margin="28,22,28,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="设置" FontSize="21" FontWeight="SemiBold" Foreground="#202939"/>
        <StackPanel Grid.Row="1" Margin="0,22,0,0">
            <TextBlock Text="常规" FontSize="13" FontWeight="SemiBold" Foreground="#667085"/>
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="开机自动启动" FontSize="13" Foreground="#202939"/>
                    <TextBlock Text="登录 Windows 后启动 JNest" FontSize="11.5" Foreground="#667085" Margin="0,4,0,0"/>
                </StackPanel>
                <CheckBox x:Name="StartupCheck" Grid.Column="1" Checked="StartupChanged" Unchecked="StartupChanged"/>
            </Grid>
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,24,0,0">
            <TextBlock Text="消息通知" FontSize="13" FontWeight="SemiBold" Foreground="#667085"/>
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="任务栏闪烁" FontSize="13" Foreground="#202939"/>
                    <TextBlock Text="有新消息时提示任务栏注意" FontSize="11.5" Foreground="#667085" Margin="0,3,0,0"/></StackPanel>
                <CheckBox x:Name="FlashCheck" Grid.Column="1" Checked="NotificationChanged" Unchecked="NotificationChanged"/>
            </Grid>
            <Grid Margin="0,15,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Windows Toast 通知" FontSize="13" Foreground="#202939"/>
                    <TextBlock Text="JNest 在后台或最小化时弹出系统通知" FontSize="11.5" Foreground="#667085" Margin="0,3,0,0"/></StackPanel>
                <CheckBox x:Name="ToastCheck" Grid.Column="1" Checked="NotificationChanged" Unchecked="NotificationChanged"/>
            </Grid>
            <Grid Margin="0,15,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="新消息提示音" FontSize="13" Foreground="#202939"/>
                    <TextBlock Text="新消息到达时播放系统提示音" FontSize="11.5" Foreground="#667085" Margin="0,3,0,0"/></StackPanel>
                <CheckBox x:Name="SoundCheck" Grid.Column="1" Checked="NotificationChanged" Unchecked="NotificationChanged"/>
            </Grid>
        </StackPanel>
        <Grid Grid.Row="3" Margin="0,18,0,0">
            <TextBlock Text="设置即时生效并自动保存" FontSize="11.5" Foreground="#667085" VerticalAlignment="Center"/>
            <Button Content="关闭" Width="90" Height="32" HorizontalAlignment="Right" IsDefault="True" Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>