<Window x:Class="JuChuang.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontFamily="Microsoft YaHei UI"
        Title="JNest 设置" Icon="Assets/app.ico" Width="540" Height="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F7F8FA" ShowInTaskbar="False"
        >
    <Window.Resources>
        <Style x:Key="SettingsCloseButtonStyle" TargetType="Button"
               BasedOn="{StaticResource JNestDialogButtonStyle}"/>
        <Style x:Key="SettingsSwitch" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent" MinHeight="34">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"/>
                            <Grid Grid.Column="1" Width="44" Height="24" VerticalAlignment="Center">
                                <Border x:Name="Track" Background="#C8C8C8" CornerRadius="12"/>
                                <Ellipse Width="18" Height="18" Fill="White"
                                         HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="ThumbTransform"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#0067C0"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                         Storyboard.TargetProperty="X" To="20" Duration="0:0:0.16"/>
                                    </Storyboard></BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                         Storyboard.TargetProperty="X" To="0" Duration="0:0:0.16"/>
                                    </Storyboard></BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Settings-only scrollbar: low-relief rail and lightly raised thumb, matching dialog buttons. -->
        <Style x:Key="JNestSettingsScrollThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbSurface" Margin="2,1"
                                CornerRadius="6" BorderThickness="1" BorderBrush="#B5BFCC"
                                SnapsToDevicePixels="True">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#E4E9F0" Offset="0"/>
                                    <GradientStop Color="#CCD5E0" Offset="0.48"/>
                                    <GradientStop Color="#BDC8D5" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#657286" Opacity="0.16"
                                                  BlurRadius="3" ShadowDepth="1"/>
                            </Border.Effect>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbSurface" Property="Background" Value="#CED8E4"/>
                                <Setter TargetName="ThumbSurface" Property="BorderBrush" Value="#9CAABD"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbSurface" Property="Background" Value="#B6C4D4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="JNestSettingsScrollArrowStyle" TargetType="{x:Type RepeatButton}">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border x:Name="ArrowSurface" Background="Transparent" CornerRadius="5" Margin="1">
                            <Path x:Name="Arrow" Data="M 3,5 L 6,8 L 9,5"
                                  Stroke="#788393" StrokeThickness="1.5" StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="12" Height="12" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="Up">
                                <Setter TargetName="Arrow" Property="Data" Value="M 3,8 L 6,5 L 9,8"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ArrowSurface" Property="Background" Value="#DEE5EE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ArrowSurface" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="JNestSettingsScrollPageStyle" TargetType="{x:Type RepeatButton}">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="JNestSettingsScrollbarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Width="{TemplateBinding Width}" SnapsToDevicePixels="True">
                            <Border Background="#F0F2F6" BorderBrush="#E2E6EC"
                                    BorderThickness="1" CornerRadius="8" Margin="1,0"/>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="18"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="18"/>
                                </Grid.RowDefinitions>
                                <RepeatButton Grid.Row="0" Tag="Up"
                                              Command="{x:Static ScrollBar.LineUpCommand}"
                                              Style="{StaticResource JNestSettingsScrollArrowStyle}"/>
                                <Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="True"
                                       Minimum="{TemplateBinding Minimum}"
                                       Maximum="{TemplateBinding Maximum}"
                                       Value="{TemplateBinding Value}"
                                       ViewportSize="{TemplateBinding ViewportSize}">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                      Style="{StaticResource JNestSettingsScrollPageStyle}"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource JNestSettingsScrollThumbStyle}"/>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                      Style="{StaticResource JNestSettingsScrollPageStyle}"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                                <RepeatButton Grid.Row="2" Tag="Down"
                                              Command="{x:Static ScrollBar.LineDownCommand}"
                                              Style="{StaticResource JNestSettingsScrollArrowStyle}"/>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="28,18,28,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False">
          <ScrollViewer.Resources>
              <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource JNestSettingsScrollbarStyle}"/>
          </ScrollViewer.Resources>
          <StackPanel Margin="0,0,8,12">
        <TextBlock Text="设置" FontSize="21" FontWeight="SemiBold" Foreground="#202939"/>
        <StackPanel Margin="0,18,0,0">
            <TextBlock Text="常规" FontSize="13" FontWeight="SemiBold" Foreground="#667085"/>
            <ToggleButton x:Name="StartupCheck" Style="{StaticResource SettingsSwitch}"
                          Margin="0,8,0,0" Checked="StartupChanged" Unchecked="StartupChanged">
                <StackPanel>
                    <TextBlock Text="开机自动启动" FontSize="13" Foreground="#202939"/>
                    <TextBlock Text="登录 Windows 后启动 JNest" FontSize="11.5" Foreground="#667085" Margin="0,2,0,0"/>
                </StackPanel>
            </ToggleButton>
        </StackPanel>
        <StackPanel Margin="0,20,0,0">
            <TextBlock Text="消息通知" FontSize="13" FontWeight="SemiBold" Foreground="#667085"/>
            <ToggleButton x:Name="FlashCheck" Style="{StaticResource SettingsSwitch}"
                          Margin="0,9,0,0" Checked="NotificationChanged" Unchecked="NotificationChanged">
                <StackPanel><TextBlock Text="任务栏闪烁" FontSize="13" Foreground="#202939"/>
                    <TextBlock Text="有新消息时提示任务栏注意" FontSize="11.5" Foreground="#667085" Margin="0,2,0,0"/></StackPanel>
            </ToggleButton>
            <ToggleButton x:Name="ToastCheck" Style="{StaticResource SettingsSwitch}"
                          Margin="0,12,0,0" Checked="NotificationChanged" Unchecked="NotificationChanged">
                <StackPanel><TextBlock Text="Windows Toast 通知" FontSize="13" Foreground="#202939"/>
                    <TextBlock Text="JNest 在后台或最小化时弹出系统通知" FontSize="11.5" Foreground="#667085" Margin="0,2,0,0"/></StackPanel>
            </ToggleButton>
            <ToggleButton x:Name="SoundCheck" Style="{StaticResource SettingsSwitch}"
                          Margin="0,12,0,0" Checked="NotificationChanged" Unchecked="NotificationChanged">
                <StackPanel><TextBlock Text="新消息提示音" FontSize="13" Foreground="#202939"/>
                    <TextBlock Text="新消息到达时播放系统提示音" FontSize="11.5" Foreground="#667085" Margin="0,2,0,0"/></StackPanel>
            </ToggleButton>
            <Border Height="1" Background="#E3E7ED" Margin="0,15,0,13"/>
            <ToggleButton x:Name="DndCheck" Style="{StaticResource SettingsSwitch}"
                          Checked="DndChanged" Unchecked="DndChanged">
                <StackPanel>
                    <TextBlock Text="免打扰时段" FontSize="13" Foreground="#202939"/>
                    <TextBlock Text="在设定时段内不弹出 Toast 通知和提示音" FontSize="11.5" Foreground="#667085" Margin="0,2,0,0"/>
                </StackPanel>
            </ToggleButton>
            <StackPanel x:Name="DndTimes" Orientation="Horizontal" HorizontalAlignment="Left"
                        Margin="0,12,0,0" IsEnabled="{Binding IsChecked, ElementName=DndCheck}">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Opacity" Value="1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=DndCheck}" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="开始" VerticalAlignment="Center" FontSize="11.5" Foreground="#667085" Margin="0,0,6,0"/>
                <ComboBox x:Name="DndStartTime" Width="83" Height="25" DisplayMemberPath="Label"
                          SelectedValuePath="Minutes" SelectionChanged="DndTimeChanged"/>
                <TextBlock Text="结束" VerticalAlignment="Center" FontSize="11.5" Foreground="#667085" Margin="14,0,6,0"/>
                <ComboBox x:Name="DndEndTime" Width="83" Height="25" DisplayMemberPath="Label"
                          SelectedValuePath="Minutes" SelectionChanged="DndTimeChanged"/>
            </StackPanel>
        </StackPanel>
            <Border Height="1" Background="#E3E7ED" Margin="0,20,0,14"/>
            <TextBlock Text="隐私与安全" FontSize="13" FontWeight="Medium"
                       Foreground="#667085"/>
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="通过独立密码锁定 JNest 全部工作区"
                           FontSize="11.5" Foreground="#667085"
                           VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0"/>
                <Button Grid.Column="1" x:Name="ChangeLockPasswordButton" Content="修改锁定密码"
                        Width="118" Height="34" VerticalAlignment="Center"
                        Style="{StaticResource SettingsCloseButtonStyle}"
                        Click="ChangeLockPassword_Click"/>
            </Grid>
          </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <TextBlock Text="设置即时生效并自动保存" FontSize="11.5" Foreground="#667085" VerticalAlignment="Center"/>
            <Button Content="关闭" Style="{StaticResource SettingsCloseButtonStyle}" Width="104" Height="34" HorizontalAlignment="Right" IsDefault="True" Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
