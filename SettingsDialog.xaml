<Window x:Class="JuChuang.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontFamily="Microsoft YaHei UI"
        Title="JNest 设置" Icon="Assets/app.ico" Width="540" Height="468"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F7F8FA" ShowInTaskbar="False"
        >
    <Window.Resources>
        <Style x:Key="SettingsCloseButtonStyle" TargetType="Button"
               BasedOn="{StaticResource JNestDialogButtonStyle}">
            <Setter Property="Width" Value="104"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="SettingsSwitch" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent" MinHeight="34">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"/>
                            <Grid Grid.Column="1" Width="44" Height="24" VerticalAlignment="Center">
                                <Border x:Name="Track" Background="#C8C8C8" CornerRadius="12"/>
                                <Ellipse Width="18" Height="18" Fill="White"
                                         HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="ThumbTransform"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#0067C0"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                         Storyboard.TargetProperty="X" To="20" Duration="0:0:0.16"/>
                                    </Storyboard></BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                         Storyboard.TargetProperty="X" To="0" Duration="0:0:0.16"/>
                                    </Storyboard></BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Quiet, narrow floating scrollbar, with no heavy track or arrows. -->
        <Style x:Key="JNestSettingsScrollThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbSurface" Background="#CDD2D9" CornerRadius="4" Margin="2,0"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbSurface" Property="Background" Value="#B2BAC5"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbSurface" Property="Background" Value="#9DA7B4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="JNestSettingsScrollPageStyle" TargetType="{x:Type RepeatButton}">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="JNestSettingsScrollbarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Width="{TemplateBinding Width}" Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True"
                                   Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Style="{StaticResource JNestSettingsScrollPageStyle}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource JNestSettingsScrollThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Style="{StaticResource JNestSettingsScrollPageStyle}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="28,18,28,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False">
          <ScrollViewer.Resources>
              <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource JNestSettingsScrollbarStyle}"/>
          </ScrollViewer.Resources>
          <StackPanel Margin="0,0,8,12">
        <StackPanel>
            <TextBlock Text="常规" FontSize="15" FontWeight="SemiBold" Foreground="#667085"/>
            <ToggleButton x:Name="StartupCheck" Style="{StaticResource SettingsSwitch}"
                          Margin="0,8,0,0" Checked="StartupChanged" Unchecked="StartupChanged">
                <StackPanel>
                    <TextBlock Text="开机自动启动" FontSize="14" Foreground="#202939"/>
                    <TextBlock Text="登录 Windows 后启动 JNest" FontSize="13" Foreground="#596273" Margin="0,3,0,0"/>
                </StackPanel>
            </ToggleButton>
        </StackPanel>
        <StackPanel Margin="0,20,0,0">
            <TextBlock Text="消息通知" FontSize="15" FontWeight="SemiBold" Foreground="#667085"/>
            <ToggleButton x:Name="FlashCheck" Style="{StaticResource SettingsSwitch}"
                          Margin="0,9,0,0" Checked="NotificationChanged" Unchecked="NotificationChanged">
                <StackPanel><TextBlock Text="任务栏闪烁" FontSize="14" Foreground="#202939"/>
                    <TextBlock Text="有新消息时提示任务栏注意" FontSize="13" Foreground="#596273" Margin="0,3,0,0"/></StackPanel>
            </ToggleButton>
            <ToggleButton x:Name="ToastCheck" Style="{StaticResource SettingsSwitch}"
                          Margin="0,12,0,0" Checked="NotificationChanged" Unchecked="NotificationChanged">
                <StackPanel><TextBlock Text="Windows Toast 通知" FontSize="14" Foreground="#202939"/>
                    <TextBlock Text="JNest 在后台或最小化时弹出系统通知" FontSize="13" Foreground="#596273" Margin="0,3,0,0"/></StackPanel>
            </ToggleButton>
            <ToggleButton x:Name="SoundCheck" Style="{StaticResource SettingsSwitch}"
                          Margin="0,12,0,0" Checked="NotificationChanged" Unchecked="NotificationChanged">
                <StackPanel><TextBlock Text="新消息提示音" FontSize="14" Foreground="#202939"/>
                    <TextBlock Text="新消息到达时播放系统提示音" FontSize="13" Foreground="#596273" Margin="0,3,0,0"/></StackPanel>
            </ToggleButton>
            <Border Height="1" Background="#E3E7ED" Margin="0,15,0,13"/>
            <ToggleButton x:Name="DndCheck" Style="{StaticResource SettingsSwitch}"
                          Checked="DndChanged" Unchecked="DndChanged">
                <StackPanel>
                    <TextBlock Text="免打扰时段" FontSize="14" Foreground="#202939"/>
                    <TextBlock Text="在设定时段内不弹出 Toast 通知和提示音" FontSize="13" Foreground="#596273" Margin="0,3,0,0"/>
                </StackPanel>
            </ToggleButton>
            <StackPanel x:Name="DndTimes" Orientation="Horizontal" HorizontalAlignment="Left"
                        Margin="0,12,0,0" IsEnabled="{Binding IsChecked, ElementName=DndCheck}">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Opacity" Value="1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=DndCheck}" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="开始" VerticalAlignment="Center" FontSize="13" Foreground="#667085" Margin="0,0,6,0"/>
                <ComboBox x:Name="DndStartTime" Width="83" Height="25" FontSize="13" DisplayMemberPath="Label"
                          SelectedValuePath="Minutes" SelectionChanged="DndTimeChanged"/>
                <TextBlock Text="结束" VerticalAlignment="Center" FontSize="13" Foreground="#667085" Margin="14,0,6,0"/>
                <ComboBox x:Name="DndEndTime" Width="83" Height="25" FontSize="13" DisplayMemberPath="Label"
                          SelectedValuePath="Minutes" SelectionChanged="DndTimeChanged"/>
            </StackPanel>
            <TextBlock x:Name="DndAllDayHint" Text="开始与结束相同，将全天免打扰"
                       FontSize="12" Foreground="#667085" Margin="0,8,0,0"
                       Visibility="Collapsed"/>
        </StackPanel>
          </StackPanel>
        </ScrollViewer>
        <!-- Align the footer button with the switches when the content fits without a scrollbar. -->
        <Grid Grid.Row="1" Margin="0,12,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SaveStatusText" Text="设置即时生效并自动保存" FontSize="13" Foreground="#667085"
                       Margin="0,0,12,0" TextWrapping="Wrap" VerticalAlignment="Center"/>
            <Button x:Name="RetrySaveButton" Grid.Column="1" Visibility="Collapsed" Content="重试"
                    Style="{StaticResource SettingsCloseButtonStyle}" Width="64" Margin="0,0,8,0" Click="RetrySave_Click"/>
            <Button Grid.Column="2" Content="关闭" Style="{StaticResource SettingsCloseButtonStyle}" HorizontalAlignment="Right" IsDefault="True" Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
