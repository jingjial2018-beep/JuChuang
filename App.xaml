<Application x:Class="JuChuang.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F3F4F6" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ChromeSurfaceBrush" Color="#F8F9FB" />
        <SolidColorBrush x:Key="SidebarSurfaceBrush" Color="#F7F8FA" />
        <SolidColorBrush x:Key="WorkspaceSurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#17191D" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#7A8391" />
        <SolidColorBrush x:Key="BorderBrush" Color="#E1E4E8" />
        <SolidColorBrush x:Key="WeChatBrush" Color="#07C160" />
        <SolidColorBrush x:Key="SelectionBrush" Color="#DFECFA" />
        <SolidColorBrush x:Key="SelectionBorderBrush" Color="#DFECFA" />
        <SolidColorBrush x:Key="AccentBrush" Color="#1677FF" />
        <SolidColorBrush x:Key="HoverBrush" Color="#ECEFF3" />
        <SolidColorBrush x:Key="SidebarHeaderBrush" Color="#596273" />
    </Application.Resources>
</Application>
