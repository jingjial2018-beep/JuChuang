<Application x:Class="JuChuang.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F3F4F6" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ChromeSurfaceBrush" Color="#F8F9FB" />
        <SolidColorBrush x:Key="SidebarSurfaceBrush" Color="#F7F8FA" />
        <SolidColorBrush x:Key="WorkspaceSurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#17191D" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#7A8391" />
        <SolidColorBrush x:Key="BorderBrush" Color="#E1E4E8" />
        <SolidColorBrush x:Key="WeChatBrush" Color="#07C160" />
        <SolidColorBrush x:Key="SelectionBrush" Color="#DFECFA" />
        <SolidColorBrush x:Key="SelectionBorderBrush" Color="#DFECFA" />
        <SolidColorBrush x:Key="AccentBrush" Color="#1677FF" />
        <SolidColorBrush x:Key="HoverBrush" Color="#ECEFF3" />
        <SolidColorBrush x:Key="SidebarHeaderBrush" Color="#596273" />

        <!-- Shared JNest modal button language: 11-DIP corners, quiet relief, consistent states. -->
        <Style x:Key="JNestDialogButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#F8F9FB"/>
            <Setter Property="Foreground" Value="#263041"/>
            <Setter Property="BorderBrush" Value="#D9DEE5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Surface" CornerRadius="11"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Border.Effect>
                                <DropShadowEffect Color="#334155" Opacity="0.12" BlurRadius="5" ShadowDepth="1"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#EEF2F6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#E3E9F0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.45"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Tag" Value="Danger"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Surface" Property="Background" Value="#FFF0F1"/>
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Tag" Value="Danger"/>
                                    <Condition Property="IsPressed" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Surface" Property="Background" Value="#FFE3E7"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="JNestDangerDialogButtonStyle" TargetType="{x:Type Button}"
               BasedOn="{StaticResource JNestDialogButtonStyle}">
            <Setter Property="Tag" Value="Danger"/>
            <Setter Property="Foreground" Value="#C53946"/>
            <Setter Property="BorderBrush" Value="#EFCBD0"/>
            <Setter Property="Background" Value="#FFF9F9"/>
        </Style>

        <!-- One PasswordBox template for create/change/confirm/unlock.
             A fixed-height centered PART_ContentHost centers both password bullets and caret. -->
        <Style x:Key="JNestPasswordBoxStyle" TargetType="{x:Type PasswordBox}">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="PasswordChar" Value="●"/>
            <Setter Property="Foreground" Value="#202939"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CAD1DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,0,9,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type PasswordBox}">
                        <Border x:Name="PasswordSurface"
                                CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Height="26"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          VerticalScrollBarVisibility="Disabled"
                                          HorizontalScrollBarVisibility="Hidden"
                                          Focusable="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="PasswordSurface" Property="BorderBrush" Value="#6899E2"/>
                                <Setter TargetName="PasswordSurface" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PasswordSurface" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
