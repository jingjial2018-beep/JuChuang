<Window x:Class="JuChuang.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontFamily="Microsoft YaHei UI"
        Title="关于 JNest" Icon="Assets/app.ico"
        Width="550" Height="380" MinWidth="480" MinHeight="330"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#FFFFFF" >
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Image Source="Assets/app-logo.png" Width="56" Height="56" Stretch="Uniform"/>
            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="JNest" FontSize="23" FontWeight="SemiBold" Foreground="#181B20"/>
                <TextBlock x:Name="VersionText" FontSize="12" Foreground="#667085"/>
            </StackPanel>
        </StackPanel>
        <ScrollViewer Grid.Row="1" Margin="0,20,0,18" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="统一管理本地微信与 WhatsApp 窗口。"
                           FontSize="15" FontWeight="SemiBold" Foreground="#252932" Margin="0,0,0,12"/>
                <TextBlock TextWrapping="Wrap" LineHeight="22" FontSize="13" Foreground="#475467"
                           Text="JNest 自动发现本地客户端窗口，支持多账号切换、窗口接入与弹出。保留微信与 WhatsApp 原生界面，并提供本地未读角标、任务栏和消息通知提醒。"/>
                <TextBlock TextWrapping="Wrap" LineHeight="22" FontSize="13" Foreground="#475467" Margin="0,12,0,0"
                           Text="账号昵称和头像仅从本地资料缓存读取；JNest 不读取聊天消息正文，也不提供聊天云同步。"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="104" Height="34" Content="确定" IsDefault="True"
                    Style="{StaticResource JNestDialogButtonStyle}" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>