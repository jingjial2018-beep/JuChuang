<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>JuChuang.RegressionProbe</AssemblyName>
    <!-- Link the real coordinator against controlled UI/scan collaborators.
         The probe's partial MainWindow intentionally shadows the application type. -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\JuChuang.csproj" />
    <Compile Include="..\..\MainWindow.Lock.cs" Link="MainWindow.Lock.cs" />
    <None Include="..\..\App.xaml" Link="ProbeAppResources.xaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
