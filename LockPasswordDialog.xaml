<Window x:Class="JuChuang.LockPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置 JNest 锁定密码" Width="430" Height="314"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="#F8F9FB" FontFamily="./Assets/Fonts/#Source Han Sans CN">
    <Grid Margin="28,22,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="Heading" Text="设置 JNest 独立密码" FontSize="19"
                   FontWeight="SemiBold" Foreground="#202939"/>
        <StackPanel x:Name="OldPasswordPanel" Grid.Row="1" Margin="0,13,0,0"
                    Visibility="Collapsed">
            <TextBlock Text="当前密码" Foreground="#475467" FontSize="12"/>
            <PasswordBox x:Name="OldPasswordBox" Height="32" Margin="0,5,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,13,0,0">
            <TextBlock Text="新密码（至少 8 个字符）" Foreground="#475467" FontSize="12"/>
            <PasswordBox x:Name="NewPasswordBox" Height="32" Margin="0,5,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,13,0,0">
            <TextBlock Text="再次输入密码" Foreground="#475467" FontSize="12"/>
            <PasswordBox x:Name="ConfirmPasswordBox" Height="32" Margin="0,5,0,0"/>
        </StackPanel>
        <TextBlock Grid.Row="4" x:Name="ErrorText" Foreground="#C13C3C"
                   FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Width="90" Height="32" Margin="0,0,12,0"
                    Click="Cancel_Click"/>
            <Button Content="确认" Width="90" Height="32" IsDefault="True"
                    Click="Confirm_Click"/>
        </StackPanel>
    </Grid>
</Window>
