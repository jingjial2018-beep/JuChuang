<Window x:Class="JuChuang.LockPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置 JNest 锁定密码" Width="410" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Icon="Assets/app.ico" ShowInTaskbar="False"
        Background="White" FontFamily="Microsoft YaHei UI">
    <Grid Margin="27,22,27,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="Heading" Text="设置 JNest 锁定密码"
                   FontSize="20" FontWeight="SemiBold" Foreground="#202939"
                   Margin="0,0,0,6"/>
        <StackPanel x:Name="OldPasswordPanel" Grid.Row="1" Width="300"
                    HorizontalAlignment="Center" Margin="0,14,0,0"
                    Visibility="Collapsed">
            <TextBlock Text="当前密码" Foreground="#475467" FontSize="13"/>
            <PasswordBox x:Name="OldPasswordBox" Margin="0,7,0,0"
                         Style="{StaticResource JNestPasswordBoxStyle}"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Width="300" HorizontalAlignment="Center" Margin="0,14,0,0">
            <TextBlock Text="新密码（至少 6 位）" Foreground="#475467" FontSize="13"/>
            <Grid Margin="0,7,0,0">
                <PasswordBox x:Name="NewPasswordBox"
                             Style="{StaticResource JNestPasswordBoxStyle}"
                             PasswordChanged="PasswordField_Changed"/>
                <TextBlock x:Name="NewPasswordPlaceholder" Text="留空可取消锁定密码"
                           Foreground="#9CA4AF" FontSize="12.5" Margin="12,0,0,0"
                           IsHitTestVisible="False" VerticalAlignment="Center"
                           Visibility="Collapsed"/>
            </Grid>
        </StackPanel>
        <StackPanel Grid.Row="3" Width="300" HorizontalAlignment="Center" Margin="0,14,0,0">
            <TextBlock Text="再次输入密码" Foreground="#475467" FontSize="13"/>
            <Grid Margin="0,7,0,0">
                <PasswordBox x:Name="ConfirmPasswordBox"
                             Style="{StaticResource JNestPasswordBoxStyle}"
                             PasswordChanged="PasswordField_Changed"/>
                <TextBlock x:Name="ConfirmPasswordPlaceholder" Text="留空可取消锁定密码"
                           Foreground="#9CA4AF" FontSize="12.5" Margin="12,0,0,0"
                           IsHitTestVisible="False" VerticalAlignment="Center"
                           Visibility="Collapsed"/>
            </Grid>
            <TextBlock Text="密码仅在本次运行期间有效。"
                       Foreground="#7A8391" FontSize="12"
                       Margin="0,9,0,0"/>
        </StackPanel>
        <!-- Removal guidance is shown only in empty password fields when changing. -->
        <TextBlock x:Name="ErrorText" Grid.Row="5" Text="" Foreground="#C13C3C"
                   FontSize="12" TextWrapping="Wrap" MinHeight="18" Margin="0,12,0,0"/>
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center"
                    Margin="0,18,0,2">
            <Button Content="取消" Width="104" Height="40" Margin="0,0,20,0"
                    Style="{StaticResource JNestDialogButtonStyle}"
                    IsCancel="True" Click="Cancel_Click"/>
            <Button Content="确认" Width="104" Height="40" IsDefault="True"
                    Style="{StaticResource JNestDialogButtonStyle}" Click="Confirm_Click"/>
        </StackPanel>
    </Grid>
</Window>
