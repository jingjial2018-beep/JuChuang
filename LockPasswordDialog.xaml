<Window x:Class="JuChuang.LockPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置 JNest 锁定密码" Width="430" Height="314"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Icon="Assets/app.ico" ShowInTaskbar="False"
        Background="#FFFFFF" FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <Style x:Key="LockDialogButtonStyle" TargetType="Button">
                    <Setter Property="Background" Value="#F8F9FB"/>
                    <Setter Property="Foreground" Value="#263041"/>
                    <Setter Property="BorderBrush" Value="#D9DEE5"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="FontWeight" Value="Medium"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Surface" CornerRadius="11"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#334155" Opacity="0.12" BlurRadius="5" ShadowDepth="1"/>
                                    </Border.Effect>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Surface" Property="Background" Value="#EEF2F6"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Surface" Property="Background" Value="#E3E9F0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
    </Window.Resources>
    <Grid Margin="28,22,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="Heading" Text="设置 JNest 独立密码" FontSize="19"
                   FontWeight="SemiBold" Foreground="#202939"/>
        <StackPanel x:Name="OldPasswordPanel" Grid.Row="1" Width="330" HorizontalAlignment="Center" Margin="0,13,0,0"
                    Visibility="Collapsed">
            <TextBlock Text="当前密码" Foreground="#475467" FontSize="12"/>
            <PasswordBox x:Name="OldPasswordBox" Height="32" Margin="0,5,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Width="330" HorizontalAlignment="Center" Margin="0,13,0,0">
            <TextBlock Text="新密码（至少 6 位）" Foreground="#475467" FontSize="12"/>
            <PasswordBox x:Name="NewPasswordBox" Height="32" Margin="0,5,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Width="330" HorizontalAlignment="Center" Margin="0,13,0,0">
            <TextBlock Text="再次输入密码" Foreground="#475467" FontSize="12"/>
            <PasswordBox x:Name="ConfirmPasswordBox" Height="32" Margin="0,5,0,0"/>
        </StackPanel>
        <TextBlock Grid.Row="4" x:Name="ErrorText" Foreground="#C13C3C"
                   FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Width="104" Height="34" Margin="0,0,12,0"
                    Style="{StaticResource LockDialogButtonStyle}" Click="Cancel_Click"/>
            <Button Content="确认" Width="104" Height="34" IsDefault="True"
                    Style="{StaticResource LockDialogButtonStyle}" Click="Confirm_Click"/>
        </StackPanel>
    </Grid>
</Window>
