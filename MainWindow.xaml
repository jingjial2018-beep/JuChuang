<Window x:Class="JuChuang.MainWindow"
        x:Name="JNestMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:JuChuang.Controls"
        mc:Ignorable="d"
        Title="JNest"
        Icon="Assets/app.ico"
        ShowInTaskbar="True"
        Width="1296"
        Height="842"
        MinWidth="1060"
        MinHeight="842"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanMinimize"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Microsoft YaHei, Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        SourceInitialized="Window_SourceInitialized">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="0"
                            CornerRadius="10"
                            GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="15,0" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="Background" Value="#FBFCFD" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F0F3F6" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#CED4DC" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E7EBEF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowControlButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#344054" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ControlBorder" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ControlBorder" Property="Background" Value="#E1E5EA" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ControlBorder" Property="Background" Value="#E8EDF3" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ControlBorder" Property="Background" Value="#DDE0E5" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="Tag" Value="Close" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ControlBorder" Property="Background" Value="#E81123"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccountItemStyle" TargetType="ListBoxItem">
            <!-- Retain the selected account background; remove the decorative blue accent stripe. -->
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="8,2" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Card"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="7">
                                <ContentPresenter />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#ECEFF3" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{StaticResource SelectionBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSidebarCollapsed, ElementName=JNestMainWindow}" Value="True">
                    <Setter Property="Margin" Value="6,2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AccountCloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#98A2B3" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="关闭这个客户端" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseBorder" Property="Background" Value="#FEECEC" />
                                <Setter Property="Foreground" Value="#D92D20" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource WindowBackgroundBrush}"
            BorderBrush="#D5D9DE"
            BorderThickness="1"
            CornerRadius="10">
        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="32" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource ChromeSurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="182" />
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="BrandHeaderPanel" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="27,0,0,0">
                        <Image Source="Assets/app-logo.png" Width="30" Height="30" Stretch="Uniform" />
                        <TextBlock Text="JNest" Margin="10,0,0,0" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" />
                    </StackPanel>

<StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right">
                        <Button x:Name="MainMenuButton" Width="44" Height="44"
                                Style="{StaticResource WindowControlButtonStyle}" ToolTip="菜单"
                                Click="OpenMainMenu_Click">
                            <Button.ContextMenu>
                                <ContextMenu x:Name="MainMenuPopup" Placement="Bottom"
                                             Background="#F8F9FB" BorderBrush="#D9DEE5"
                                             BorderThickness="1" Padding="8" Width="240"
                                             HasDropShadow="True">
                                    <ContextMenu.Template>
                                        <ControlTemplate TargetType="ContextMenu">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="1" CornerRadius="13" Padding="6">
                                                <StackPanel IsItemsHost="True"/>
                                            </Border>
                                        </ControlTemplate>
                                    </ContextMenu.Template>
                                    <ContextMenu.Resources>
                                        <Style TargetType="MenuItem">
                                            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
                                            <Setter Property="FontSize" Value="13.5"/>
                                            <Setter Property="Foreground" Value="#263041"/>
                                            <Setter Property="Height" Value="39"/>
                                            <Setter Property="Padding" Value="17,0"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="MenuItem">
                                                        <Border x:Name="MenuRow" Background="Transparent" CornerRadius="7" Margin="2,1">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,8,0">
                                                            <ContentPresenter ContentSource="Icon" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsHighlighted" Value="True">
                                                                <Setter TargetName="MenuRow" Property="Background" Value="#E8EDF3"/>
                                                            </Trigger>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter Property="Opacity" Value="0.42"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                        <Style TargetType="Separator">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Separator">
                                                        <Border Height="1" Margin="12,8" Background="#DDE2E9"/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ContextMenu.Resources>
                                    <MenuItem x:Name="AddWeChatButton" Header="添加微信" Click="NewWeChat_Click"><MenuItem.Icon><Path Width="20" Height="20" Stretch="Uniform" Fill="#3F4C5C" Data="F0 M3.0,4.5 1.6,8.5 2.4,10.9 4.1,12.7 3.7,15.2 6.0,13.6 8.7,14.0 11.1,16.4 15.2,16.6 17.0,17.7 16.6,15.9 18.1,14.2 18.3,11.8 17.3,10.0 15.2,8.7 15.0,6.3 13.4,4.0 10.5,2.5 7.9,2.2 5.3,2.8 Z M10.3,10.1 13.9,9.0 17.1,10.6 17.8,13.2 16.0,15.7 16.1,16.7 15.3,16.0 12.0,16.1 9.9,14.8 9.0,12.3 Z M14.8,10.6 14.1,11.7 15.2,12.5 15.9,11.4 Z M14.9,11.2 15.1,11.9 Z M11.7,10.6 10.9,11.7 12.0,12.5 12.8,11.4 Z M11.8,11.2 12.0,11.9 Z M12.8,4.3 14.3,6.2 14.7,8.5 10.8,9.1 8.9,10.8 8.5,13.4 5.9,13.0 4.4,14.1 4.7,12.5 2.9,10.7 2.1,8.5 3.3,5.0 5.3,3.5 7.9,2.8 10.5,3.0 Z M10.4,5.0 9.4,6.4 10.8,7.5 11.8,6.1 Z M10.5,5.6 11.2,6.1 10.7,6.9 10.0,6.4 Z M6.1,5.0 5.0,6.4 6.4,7.5 7.5,6.1 Z M6.1,5.6 6.9,6.1 6.4,6.9 5.6,6.4 Z"/></MenuItem.Icon></MenuItem>
                                    <MenuItem x:Name="AddWhatsAppMenuItem" Header="添加 WhatsApp" Click="AddWhatsApp_Click"><MenuItem.Icon><Path Width="20" Height="20" Stretch="Uniform" Fill="#3F4C5C" Data="F0 M16.6,2.5 13.4,0.6 9.4,0.0 6.0,0.8 2.5,3.4 0.8,6.0 0.0,8.9 0.2,12.0 1.5,15.3 0.5,19.7 4.9,18.6 8.6,19.9 12.0,19.8 15.1,18.6 17.5,16.6 19.4,13.4 20.0,9.4 19.1,6.0 Z M16.0,3.0 18.1,5.5 19.2,9.3 18.8,12.7 17.0,16.0 14.7,17.9 11.8,19.1 8.4,19.1 5.0,17.8 1.3,18.8 2.3,15.1 0.9,12.0 0.8,8.9 3.0,3.9 5.5,1.9 9.3,0.7 12.7,1.1 Z M5.2,3.9 3.9,5.8 3.6,8.1 6.4,13.0 11.1,15.8 13.6,16.0 15.5,15.2 16.6,12.5 13.8,10.7 11.6,12.5 9.9,11.6 7.3,8.8 8.2,6.9 7.0,4.3 Z M5.6,4.5 6.3,4.6 7.5,6.7 6.5,8.5 7.7,10.6 11.5,13.2 13.8,11.5 15.9,12.9 15.1,14.6 13.4,15.3 11.1,15.1 6.9,12.4 4.3,7.9 Z"/></MenuItem.Icon></MenuItem>
                                    <MenuItem x:Name="PopOutButton" IsEnabled="False" Click="PopOutButton_Click"
                                              ToolTip="将当前客户端恢复为桌面独立窗口">
                                        <MenuItem.Icon><Path Width="20" Height="20" Stretch="Uniform" Fill="#3F4C5C" Data="F0 M3.4,3.3 2.5,5.1 2.5,14.1 3.1,15.5 5.2,16.6 13.9,16.6 15.6,16.0 16.6,13.9 16.6,5.2 16.0,3.6 14.1,2.5 5.1,2.5 Z M3.9,3.9 5.3,3.3 13.9,3.3 15.4,4.1 15.8,14.1 15.1,15.4 5.0,15.8 3.7,15.0 3.3,5.3 Z M7.6,6.8 7.8,7.5 11.1,7.5 6.8,12.3 11.6,8.1 11.7,11.4 12.3,11.6 12.3,6.8 Z"/></MenuItem.Icon>
                                        <MenuItem.Header>
                                            <TextBlock x:Name="PopOutButtonText" Text="弹出窗口"/>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <MenuItem Header="全部接入" Click="ReconnectAll_Click"><MenuItem.Icon><Path Width="20" Height="20" Stretch="Uniform" Fill="#3F4C5C" Data="F0 M1.9,13.0 2.3,16.2 4.4,17.7 15.5,17.7 17.4,16.6 18.1,15.0 18.1,13.0 17.3,12.5 16.8,15.4 15.6,16.4 4.5,16.4 3.2,15.3 3.0,12.8 Z M9.8,2.3 9.4,11.7 6.8,9.4 6.1,10.2 10.2,13.7 13.9,9.8 12.9,9.5 10.6,11.7 10.6,2.8 Z"/></MenuItem.Icon></MenuItem>
                                    <MenuItem Header="扫描客户端" Click="ScanClients_Click"><MenuItem.Icon><Path Width="20" Height="20" Stretch="Uniform" Fill="#3F4C5C" Data="F0 M9.7,8.6 8.4,9.5 8.2,10.8 8.9,11.9 10.3,12.3 11.5,11.5 11.8,10.2 11.0,8.9 Z M9.6,9.0 10.7,9.1 11.5,10.2 10.3,12.0 8.5,10.7 Z M7.4,5.1 4.4,8.4 4.6,13.0 7.9,15.9 9.0,13.9 6.8,12.0 6.7,9.1 8.6,7.2 11.2,7.1 12.7,8.2 13.5,10.0 13.0,12.3 11.0,13.9 12.0,15.8 12.6,15.8 15.5,12.6 15.4,8.0 12.1,4.9 Z M7.9,5.3 12.1,5.3 15.2,8.4 15.2,12.4 12.3,15.5 11.4,14.1 13.4,12.3 13.8,10.0 13.0,8.1 11.4,6.8 8.4,6.9 6.4,8.9 6.4,12.1 8.6,14.1 7.7,15.5 4.8,12.6 4.8,8.4 Z M5.9,1.3 2.5,3.9 0.6,6.9 0.0,11.1 0.9,14.6 3.2,17.8 5.9,19.5 6.9,17.5 4.2,15.5 2.9,13.4 2.3,10.9 2.9,7.5 4.4,5.2 6.9,3.5 9.8,2.8 12.6,3.3 16.0,5.8 17.6,9.6 16.6,14.3 13.0,17.5 14.3,19.5 17.3,17.3 19.3,14.0 20.0,9.9 19.1,6.4 16.6,3.0 13.6,1.1 9.6,0.5 Z M5.9,1.7 9.5,0.8 13.3,1.4 16.3,3.2 18.8,6.4 19.6,9.8 19.1,13.8 17.1,17.0 14.3,19.1 13.4,17.6 17.0,14.2 17.9,9.6 16.3,5.7 12.8,3.0 9.9,2.5 7.0,3.1 4.8,4.5 2.7,7.3 2.3,12.4 3.8,15.5 6.5,17.6 5.7,19.1 2.9,17.0 1.1,14.4 0.3,11.1 1.0,6.8 2.7,4.1 Z"/></MenuItem.Icon></MenuItem>
                                    <Separator/>
                                    <MenuItem Header="设置" Click="Settings_Click"><MenuItem.Icon><Path Width="20" Height="20" Stretch="Uniform" Fill="#3F4C5C" Data="F0 M9.1,0.6 7.9,1.3 7.2,3.0 4.8,2.4 2.8,3.9 2.4,5.5 3.1,7.0 0.9,8.4 0.6,10.9 1.3,12.1 3.0,12.8 2.4,15.2 3.9,17.2 5.5,17.6 7.0,16.8 8.3,19.1 10.9,19.3 12.1,18.7 12.8,16.9 15.2,17.6 17.2,16.0 17.6,14.5 16.8,13.0 19.1,11.6 19.3,9.1 18.7,7.9 16.9,7.2 17.6,4.8 16.0,2.8 14.5,2.4 12.9,3.1 11.6,0.9 Z M9.2,1.8 11.0,2.0 11.6,3.6 12.7,4.3 15.2,3.7 16.4,4.9 15.8,7.7 18.1,9.2 18.0,11.0 16.4,11.6 15.7,12.7 16.2,15.2 15.0,16.4 12.2,15.8 10.8,18.1 8.9,18.0 7.5,15.7 4.7,16.2 3.6,15.0 4.1,12.2 1.8,10.8 2.0,8.9 3.6,8.4 4.3,7.3 3.7,4.7 5.1,3.6 6.7,4.3 7.9,4.1 Z M9.6,5.6 6.7,7.1 5.6,10.4 7.3,13.4 10.4,14.3 13.2,12.9 14.3,9.6 12.9,6.7 Z M9.6,6.8 11.9,7.5 13.1,9.7 12.5,11.9 10.3,13.1 8.1,12.5 6.8,10.3 7.5,8.1 Z"/></MenuItem.Icon></MenuItem>
                                    <MenuItem Header="关于 JNest" Click="About_Click"><MenuItem.Icon><Path Width="20" Height="20" Stretch="Uniform" Fill="#3F4C5C" Data="F0 M9.4,0.0 6.0,0.8 2.5,3.4 0.6,6.6 0.0,10.5 0.8,14.0 3.4,17.5 6.6,19.4 10.5,20.0 14.0,19.1 17.5,16.6 19.4,13.4 20.0,9.4 19.1,6.0 16.6,2.5 13.4,0.6 Z M9.2,1.8 12.3,2.1 15.1,3.6 17.2,6.1 18.2,9.2 17.9,12.3 16.4,15.1 13.9,17.2 10.7,18.2 7.6,17.9 4.9,16.4 2.8,13.9 1.8,10.7 2.1,7.6 3.6,4.9 6.1,2.8 Z M9.9,8.5 9.1,9.2 9.1,15.0 10.2,15.7 10.9,15.0 10.9,9.2 Z M9.7,4.3 8.8,5.6 10.3,6.6 11.2,5.3 Z"/></MenuItem.Icon></MenuItem>
                                    <Separator/>
                                    <MenuItem Header="退出 JNest" Click="Close_Click"><MenuItem.Icon><Path Width="20" Height="20" Stretch="Uniform" Fill="#3F4C5C" Data="F0 M14.8,6.1 14.4,6.8 16.2,9.4 9.0,9.4 8.6,10.2 16.2,10.6 14.4,13.2 15.2,13.9 18.1,9.8 Z M2.9,1.7 1.9,3.4 2.1,17.5 4.3,18.6 12.1,17.1 13.1,15.5 12.6,11.9 11.9,12.3 11.3,16.2 4.2,17.4 3.2,16.9 3.1,3.4 4.2,2.5 11.4,3.8 12.3,8.1 13.1,7.6 12.7,3.5 11.1,2.5 4.3,1.3 Z"/></MenuItem.Icon></MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                            <Path Width="15" Height="15" Stroke="#344054" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M2,3 H13 M2,7.5 H13 M2,12 H13"/>
                        </Button>
                        <Button Style="{StaticResource WindowControlButtonStyle}" ToolTip="最小化" Click="Minimize_Click">
                            <Path Width="10" Height="10" Stretch="Uniform" Stroke="#344054" StrokeThickness="1.3"
                                  Data="M1,5 H9" />
                        </Button>
                        <Button x:Name="MaximizeButton" Style="{StaticResource WindowControlButtonStyle}"
                                ToolTip="最大化" Click="Maximize_Click">
                            <Path x:Name="MaximizeGlyph" Width="13" Height="13" Stretch="Uniform" Stroke="#344054"
                                  StrokeThickness="1.15" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" Data="M4,3 H10 Q11,3 11,4 V10 Q11,11 10,11 H4 Q3,11 3,10 V4 Q3,3 4,3 Z" />
                        </Button>
                        <Button x:Name="CloseWindowButton" ToolTip="关闭" Tag="Close" Click="Close_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource WindowControlButtonStyle}">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#E81123" />
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Path Width="10" Height="10" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M1,1 L9,9 M9,1 L1,9" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="280" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Layered desktop: continuous matte sidebar surface (zone A). -->
                <Border Grid.Column="0" BorderBrush="#CBD2DB" BorderThickness="0,0,1,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#F3F5F8" Offset="0"/>
                            <GradientStop Color="#EBEFF4" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="48" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <TextBlock x:Name="SidebarHeading" Margin="20,0,48,0" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource SidebarHeaderBrush}" VerticalAlignment="Center">
                                <Run Text="账号与窗口" /><Run Text=" · " /><Run Text="{Binding Entries.Count, Mode=OneWay}" />
                            </TextBlock>
                            <Button x:Name="SidebarToggleButton" Width="36" Height="36" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Margin="0,0,10,0" Background="#E4E7EB"
                                    BorderThickness="0" FocusVisualStyle="{x:Null}" Cursor="Hand" Click="SidebarToggle_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="ToggleCircle" Background="{TemplateBinding Background}" CornerRadius="18">
                                            <Path Data="M3,4 H15 Q17,4 17,6 V14 Q17,16 15,16 H3 Q1,16 1,14 V6 Q1,4 3,4 Z M7,4 V16"
                                                  Width="18" Height="18" Stretch="Uniform" Stroke="#616873"
                                                  StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleCircle" Property="Background" Value="#D4DAE2"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                        <ListBox x:Name="AccountsList" Grid.Row="1" ItemsSource="{Binding Entries}"
                                 SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                                 SelectionChanged="AccountsList_SelectionChanged"
                                 PreviewMouseLeftButtonDown="AccountsList_PreviewMouseLeftButtonDown"
                                 PreviewMouseMove="AccountsList_PreviewMouseMove"
                                 DragOver="AccountsList_DragOver"
                                 Drop="AccountsList_Drop"
                                 AllowDrop="True"
                                 ItemContainerStyle="{StaticResource AccountItemStyle}"
                                 Background="Transparent" BorderThickness="0" Padding="0,0,0,8"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid x:Name="AccountItemGrid" Height="84" Margin="12,0,8,0">
                                        <Grid.ToolTip>
                                            <ToolTip Placement="Right" HorizontalOffset="12" Content="{Binding DisplayName}" />
                                        </Grid.ToolTip>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition x:Name="AccountAvatarColumn" Width="60" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition x:Name="AccountCloseColumn" Width="30" />
                                        </Grid.ColumnDefinitions>
                                        <Grid x:Name="AccountAvatarGrid" Width="52" Height="52" VerticalAlignment="Center" HorizontalAlignment="Center" ClipToBounds="False">
                                            <Ellipse x:Name="WeChatFallbackIcon" Width="48" Height="48" Visibility="Collapsed">
                                                <Ellipse.Fill>
                                                    <ImageBrush ImageSource="pack://application:,,,/Assets/wechat-icon.jpg" Stretch="UniformToFill" />
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <Ellipse x:Name="WhatsAppFallbackIcon" Width="48" Height="48" Visibility="Collapsed">
                                                <Ellipse.Fill>
                                                    <ImageBrush ImageSource="pack://application:,,,/Assets/whatsapp-icon.png" Stretch="UniformToFill" />
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <Ellipse x:Name="AvatarImage" Width="48" Height="48" Visibility="Collapsed">
                                                <Ellipse.Fill>
                                                    <ImageBrush ImageSource="{Binding AvatarPath}" Stretch="UniformToFill"
                                                                AlignmentX="Center" AlignmentY="Center" />
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <!-- 未读角标：头像左上角。
                                                 AlertDisplayMode=Count 显示数字；Dot 显示纯红点；None 整体隐藏。
                                                 数字来自 BadgeDetector 截图识别（高置信度模板匹配结果）。 -->
                                            <Border x:Name="UnreadBadge" MinWidth="20" Height="20" Padding="5,0"
                                                    Background="#F04438" BorderBrush="#FFFFFF" BorderThickness="1.5"
                                                    CornerRadius="10" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                    Margin="-2,-2,0,0" Visibility="Collapsed" Panel.ZIndex="10">
                                                <TextBlock x:Name="UnreadBadgeText" Text="{Binding MessageAlertText}" FontSize="11"
                                                           FontWeight="SemiBold" Foreground="#FFFFFF"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <!-- 纯红点（无数字）：AlertDisplayMode=Dot 时叠加覆盖在角标上。 -->
                                            <Ellipse x:Name="UnreadDot" Width="10" Height="10"
                                                     Fill="#F04438" Stroke="#FFFFFF" StrokeThickness="1.5"
                                                     HorizontalAlignment="Left" VerticalAlignment="Top"
                                                     Margin="-1,-1,0,0" Visibility="Collapsed" Panel.ZIndex="10" />
                                        </Grid>
                                        <StackPanel x:Name="AccountDetails" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}" />
                                            <TextBlock Text="{Binding ClientLabel}" Margin="0,2,0,0" FontSize="13"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <Ellipse Width="6" Height="6" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding StatusSummary}" Margin="6,0,0,0" FontSize="13"
                                                           Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding ProfileDiagnosticText}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Button x:Name="EntryCloseButton" Grid.Column="2"
                                                Style="{StaticResource AccountCloseButtonStyle}"
                                                CommandParameter="{Binding}" Content="×" Click="CloseEntry_Click"
                                                VerticalAlignment="Center" Opacity="0" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter TargetName="AccountDetails" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="EntryCloseButton" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="AccountItemGrid" Property="Margin" Value="0" />
                                            <Setter TargetName="AccountAvatarGrid" Property="Width" Value="52" />
                                            <Setter TargetName="AccountAvatarColumn" Property="Width" Value="52" />
                                            <Setter TargetName="AccountCloseColumn" Property="Width" Value="0" />
                                                                                    <Setter TargetName="AccountItemGrid" Property="Height" Value="72" />
                                            <Setter TargetName="AccountAvatarGrid" Property="HorizontalAlignment" Value="Center" />
                                            <Setter TargetName="WeChatFallbackIcon" Property="Width" Value="40" />
                                            <Setter TargetName="WeChatFallbackIcon" Property="Height" Value="40" />
                                            <Setter TargetName="WhatsAppFallbackIcon" Property="Width" Value="40" />
                                            <Setter TargetName="WhatsAppFallbackIcon" Property="Height" Value="40" />
                                            <Setter TargetName="AvatarImage" Property="Width" Value="40" />
                                            <Setter TargetName="AvatarImage" Property="Height" Value="40" />
                                            <Setter TargetName="UnreadBadge" Property="Height" Value="18" />
                                            <Setter TargetName="UnreadBadge" Property="MinWidth" Value="18" />
                                            <Setter TargetName="UnreadBadge" Property="Padding" Value="3,0" />
                                            <Setter TargetName="UnreadBadge" Property="CornerRadius" Value="9" />
                                            <Setter TargetName="UnreadBadge" Property="Margin" Value="1,0,0,0" />
                                            <Setter TargetName="UnreadBadgeText" Property="FontSize" Value="9" />
                                            <Setter TargetName="UnreadDot" Property="Margin" Value="1,0,0,0" />
</DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasAvatar}" Value="False" />
                                                <Condition Binding="{Binding Kind}" Value="WeChat" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="WeChatFallbackIcon" Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasAvatar}" Value="False" />
                                                <Condition Binding="{Binding Kind}" Value="WhatsApp" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="WhatsAppFallbackIcon" Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                        <DataTrigger Binding="{Binding HasAvatar}" Value="True">
                                            <Setter TargetName="AvatarImage" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasMessageAlert}" Value="True">
                                            <Setter TargetName="UnreadBadge" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding AlertDisplayMode}" Value="Dot">
                                            <Setter TargetName="UnreadDot" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="UnreadBadge" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding AlertDisplayMode}" Value="Count">
                                            <Setter TargetName="UnreadDot" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="UnreadBadge" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding AlertDisplayMode}" Value="None">
                                            <Setter TargetName="UnreadDot" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="UnreadBadge" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter TargetName="EntryCloseButton" Property="Opacity" Value="1" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Fixed 1-DIP divider: do not intercept input or resize sidebar. -->
                <Border Grid.Column="1" Background="#CBD2DB" IsHitTestVisible="False" />

                <!-- Zone B/C: a calm recessed workspace surface behind native windows.
                     No hosting bounds, clipping, window styles or input behavior change. -->
                <Grid Grid.Column="2">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#E9EDF2" Offset="0"/>
                            <GradientStop Color="#E3E8EE" Offset="0.88"/>
                            <GradientStop Color="#DEE5ED" Offset="1"/>
                        </LinearGradientBrush>
                    </Grid.Background>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- Compact 32-DIP account status header (zone B). -->
                    <Border Grid.Row="0" BorderBrush="#CBD3DE" BorderThickness="0,0,0,1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#F5F7FA" Offset="0"/>
                                <GradientStop Color="#EAEFF5" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid Margin="20,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="CurrentTitleText" Text="等待客户端" FontSize="15.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" />
                                <Ellipse x:Name="CurrentStatusDot" Width="7" Height="7" Margin="11,1,6,0"
                                         Fill="#98A2B3" VerticalAlignment="Center" />
                                <TextBlock x:Name="CurrentStatusText" Text="尚未接入" FontSize="12.5"
                                           Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="本地管理 · 不读取聊天消息正文"
                                       FontSize="12.5" Foreground="#667085"
                                       VerticalAlignment="Center" TextAlignment="Right" />
                        </Grid>
                    </Border>
                    <Grid x:Name="ClientArea" Grid.Row="1" ClipToBounds="True"
                          SnapsToDevicePixels="True">
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#E9EDF2" Offset="0"/>
                                <GradientStop Color="#E4E9F0" Offset="0.93"/>
                                <GradientStop Color="#DBE2EA" Offset="1"/>
                            </LinearGradientBrush>
                        </Grid.Background>
                        <!-- 通铺式嵌入：原生窗口直接铺满整个工作区，不做卡片包装
                             （无留白/无边框/无圆角/无投影）。窗口左右紧贴侧栏与外壳，
                             视觉上作为界面的一部分存在，而非悬浮的独立卡片。 -->
                        <controls:ExternalWindowHost x:Name="WindowHost" Visibility="Collapsed" />
                        <Grid x:Name="EmptyState" Background="{StaticResource WorkspaceSurfaceBrush}">
                            <StackPanel Width="420" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="56" Height="56" Background="#EAF2FF" CornerRadius="16">
                                    <Path Width="22" Height="22" Stretch="Uniform" Stroke="{StaticResource AccentBrush}"
                                          StrokeThickness="1.4" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Data="M2,2 H12 V12 H2 Z M5,5 H9 V9 H5 Z" />
                                </Border>
                                <TextBlock x:Name="EmptyStateTitle" Text="还没有接入客户端窗口" Margin="0,16,0,0"
                                           FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"
                                           TextAlignment="Center" />
                                <TextBlock x:Name="EmptyStateDescription"
                                           Text="点击顶部“添加微信”，程序会自动发现并嵌入本地客户端。"
                                           Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" TextAlignment="Center" LineHeight="20" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>

            <Border Grid.Row="2" Background="{StaticResource ChromeSurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,10,10">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="#12B76A" />
                        <TextBlock x:Name="WindowCountText" Text="已接入 0 个窗口" Margin="8,0,0,0"
                                   FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="StatusMessageText" Grid.Column="1" Margin="20,0" FontSize="13"
                               Foreground="#667085" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="LocalDateText" FontSize="13" Foreground="#667085" FontFamily="Consolas" VerticalAlignment="Center" />
                        <TextBlock x:Name="LocalTimeText" Margin="12,0,0,0" FontSize="14" Foreground="#475467"
                                   FontWeight="SemiBold" FontFamily="Consolas" VerticalAlignment="Center" />
                        <TextBlock x:Name="LocalTimeZoneText" Margin="12,0,0,0" FontSize="13"
                                   Foreground="#667085" FontFamily="Consolas" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
