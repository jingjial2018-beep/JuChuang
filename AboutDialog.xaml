<Window x:Class="JuChuang.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于 JNest" Icon="Assets/app.ico"
        Width="520" SizeToContent="Height" MinHeight="260"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#FFFFFF" ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <Image Source="Assets/app-logo.png" Width="64" Height="64" Stretch="Uniform" Margin="0,0,16,0"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="JNest" FontSize="24" FontWeight="SemiBold" Foreground="#171B24"/>
                <TextBlock x:Name="VersionText" FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
            </StackPanel>
        </StackPanel>
        <TextBlock Grid.Row="1" TextWrapping="Wrap" FontSize="13" LineHeight="22" Foreground="#344054"
                   Text="统一管理本地微信与 WhatsApp 窗口。支持多账号切换、未读角标与任务栏提醒。消息检测在本机完成，不读取聊天消息正文。"/>
        <Button Grid.Row="2" Content="确定" Width="92" Height="34"
                HorizontalAlignment="Right" Margin="0,24,0,0"
                IsDefault="True" Click="Close_Click"/>
    </Grid>
</Window>