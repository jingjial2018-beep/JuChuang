<Window x:Class="JuChuang.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于 JNest" Icon="Assets/app.ico"
        Width="540" Height="378" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#FFFFFF" ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI, Segoe UI">
    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Image Source="Assets/app-logo.png" Width="56" Height="56" Stretch="Uniform" Margin="0,0,16,0"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="JNest" FontSize="23" FontWeight="SemiBold" Foreground="#182230"/>
                <TextBlock Text="本地多账号窗口管理工具" FontSize="12.5" Foreground="#667085" Margin="0,2,0,0"/>
                <TextBlock x:Name="VersionText" FontSize="11.5" Foreground="#667085" Margin="0,3,0,0"/>
            </StackPanel>
        </StackPanel>
        <Border Grid.Row="1" Background="#E4E7EC" Height="1" Margin="0,20,0,18"/>
        <StackPanel Grid.Row="2">
            <TextBlock TextWrapping="Wrap" LineHeight="22" FontSize="13" Foreground="#344054"
                       Text="JNest 为本地运行的微信与 WhatsApp 桌面客户端提供统一的窗口管理环境，支持多账号切换、窗口接入与恢复，以及未读状态和系统通知提醒。"/>
            <TextBlock Text="本地运行与隐私" FontSize="13" FontWeight="SemiBold" Foreground="#344054"
                       Margin="0,19,0,7"/>
            <TextBlock TextWrapping="Wrap" LineHeight="21" FontSize="12.5" Foreground="#667085"
                       Text="JNest 保留原生客户端界面，不读取聊天消息正文，也不提供聊天内容的云端同步服务。"/>
        </StackPanel>
        <Grid Grid.Row="3">
            <Grid.Resources>
                <Style x:Key="AboutConfirmStyle" TargetType="Button">
                    <Setter Property="Background" Value="#F8F9FB"/>
                    <Setter Property="Foreground" Value="#263041"/>
                    <Setter Property="BorderBrush" Value="#D9DEE5"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="FontWeight" Value="Medium"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Surface" CornerRadius="11"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#334155" Opacity="0.12" BlurRadius="5" ShadowDepth="1"/>
                                    </Border.Effect>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Surface" Property="Background" Value="#EEF2F6"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Surface" Property="Background" Value="#E3E9F0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Grid.Resources>
            <TextBlock Text="Windows 11 · 64 位" FontSize="11.5" Foreground="#98A2B3" VerticalAlignment="Center"/>
            <Button Content="确定" Width="112" Height="40" HorizontalAlignment="Right"
                    Style="{StaticResource AboutConfirmStyle}"
                    IsDefault="True" Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>