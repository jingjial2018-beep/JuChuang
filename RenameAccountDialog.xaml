<Window x:Class="JuChuang.RenameAccountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="重命名账号"
        Width="400"
        Height="205"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F7F8FA"
        FontFamily="Microsoft YaHei UI, 'Segoe UI Variable Text', 'Segoe UI', system-ui, sans-serif">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="账号名称"
                   FontSize="17"
                   FontWeight="SemiBold"
                   Foreground="#172033" />
        <TextBlock Grid.Row="1"
                   Margin="0,5,0,0"
                   Text="名称会按头像保存，下次打开时自动恢复。"
                   FontSize="12"
                   Foreground="#697386" />
        <TextBox x:Name="NameTextBox"
                 Grid.Row="2"
                 Height="38"
                 Margin="0,14,0,0"
                 Padding="10,7"
                 MaxLength="30"
                 FontSize="14"
                 VerticalContentAlignment="Center" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Width="82" Height="34" Margin="0,0,10,0" Content="取消" IsCancel="True" />
            <Button Width="82" Height="34" Content="保存" IsDefault="True" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
